{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "erp-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "erp-dev-nowatch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "server.ts"
      ],
      "port": 3000
    },
    {
      "name": "erp-dev-clock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set ALLOW_DEV_CLOCK=1&& npx tsx server.ts"
      ],
      "port": 3000
    }
  ]
}