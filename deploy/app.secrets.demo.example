# Template only — NOT real secrets. Create the real file BY HAND on the VPS as ~/apps/erp-demo/app.secrets
# (never through git or chat). Every value below is different from live on purpose, except where noted.

# --- database: its own database and its own owner role (created by deploy/setup-demo.sh) ---
SQL_HOST=localhost
SQL_USER=erp_demo
SQL_PASSWORD=
SQL_DB_NAME=erp_demo

# --- restricted role for row-level security ---
# SAME role and SAME password as live (it is one Postgres role; the policies are written for it). Copy the two values by hand
# from ~/apps/erp/app.secrets. The role has no access to a database it has not been granted on, and demo only connects to erp_demo.
TENANT_DB_USER=erp_app_tenant
TENANT_DB_PASSWORD=

# --- new values, never reused from live. Generate each with: openssl rand -base64 32 ---
SESSION_SECRET=
ZATCA_KEY_ENCRYPTION_SECRET=

# --- where and how this copy runs ---
PORT=4000
HOST=127.0.0.1
SESSION_COOKIE_NAME=warraq2.sid
APP_BASE_URL=http://localhost:4000
APP_ENV=demo

# --- deliberately NOT set in demo ---
#   SMTP_*                 (demo never sends email)
#   ZATCA_ALLOW_LIVE_CALLS (demo can never make Production ZATCA calls; the scrub also removes every ZATCA key)
#   GEMINI_API_KEY

# Same Chromium as live, for Download PDF (copy the value from live if live sets it):
# PLAYWRIGHT_CHROMIUM_PATH=
