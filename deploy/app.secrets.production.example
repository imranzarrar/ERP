# Template only — NOT real secrets, never contains real values, safe to commit.
#
# Create the real file by hand directly on the VPS as `app.secrets` in the repo root
# (never copy it through git, chat, or any file transfer from a dev machine). See
# CLAUDE.md's Secrets section and docs/deployment-plan.md's guardrails.

# --- Required: database ---
SQL_HOST=localhost
SQL_USER=erp_app
SQL_PASSWORD=
SQL_DB_NAME=erp_production

# --- Required: session + ZATCA key encryption ---
# Generate each with: openssl rand -base64 32
# Use DIFFERENT values from local dev, and different again from any other environment.
SESSION_SECRET=
ZATCA_KEY_ENCRYPTION_SECRET=

# --- Optional: connection pool tuning (sane defaults if unset) ---
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=15000

# --- Optional: list-endpoint pagination limits (sane defaults if unset) ---
# DEFAULT_LIST_LIMIT=500
# MAX_LIST_LIMIT=2000

# --- Optional: outgoing email (password reset). Leave unset to disable — the app fails
# closed with a clear error on any route that needs it, rather than silently no-op'ing. ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="ERP <noreply@yourdomain.com>"

# --- Optional: used to build absolute links (e.g. password reset emails) when there's no
# inbound request to infer the host/protocol from. Set once a real domain exists; safe to
# leave unset on the bare-IP setup, where it falls back to the request's own host. ---
# APP_BASE_URL=https://erp.yourdomain.com

# --- Optional: Gemini API key for the in-app "Auto-Translate" button. Not configured
# anywhere in this project today — leave unset unless you deliberately want that feature. ---
# GEMINI_API_KEY=

# --- ZATCA safety interlock — leave UNSET until you are deliberately ready to let this
# server make real Production-environment ZATCA calls. Sandbox/Simulation calls are
# unaffected either way. Do not set this casually. ---
# ZATCA_ALLOW_LIVE_CALLS=true
