# env files
.env
.env.*
# Renamed from .env — deliberately non-standard so nothing on a hosting platform that
# specifically manages files named .env (dashboard-injected env vars, deploy templating)
# recognizes or overwrites this one. See CLAUDE.md's Secrets section.
app.secrets

# logs
*.log

# database dumps / backups
*.sql
db-backups/

# Claude Code scratch output (throwaway test artifacts, not project source)
.claude/scratch/

# secrets
src/db/dbCredentials.ts

# Reference-only material never read by the running app at runtime (no server route
# serves them, nothing spawns the SDK jar — confirmed before untracking) — kept locally
# for developer reference, deliberately not shipped to production. docs/zatca/ (the
# onboarding manuals) stays tracked/pushed — only the raw ZATCA PDFs and the SDK binary
# itself are excluded.
/ZATCA Help/
/tools/zatca-sdk/

